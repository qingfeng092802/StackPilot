# 复制成 .env.local 后填真实值。.env.local 已在 .gitignore 里，不会进仓库。
#
# 本地启动：npm run dev
# 线上：在平台的环境变量面板里逐条添加，**不要**上传这个文件

# 模型端点（Anthropic 协议兼容）
#   官方：https://api.anthropic.com
#   DeepSeek：https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 真实的 API Key。缺这个服务会直接退出（见 server/index.ts 的 assertEnv）
# 这里故意不写 sk- 开头，免得被密钥扫描工具误报
ANTHROPIC_API_KEY=在这里粘贴你的key

# 模型名。留空则用端点默认值
ANTHROPIC_MODEL=deepseek-flash
